# HTTP port for `python app.py` / uvicorn (avoid 8000 / 8500 if other apps use them)
# QACOPILOT_API_PORT=8843

GROQ_API_KEY=
# Optional: openai/gpt-oss-120b, llama-3.3-70b-versatile, etc. (see Groq docs)
GROQ_MODEL=llama-3.3-70b-versatile

# Local Qdrant persistence (no Docker required)
QDRANT_PATH=./qdrant_storage

# Optional: remote Qdrant instead of path
# QDRANT_URL=http://127.0.0.1:6333

# Data paths (backend/lib/settings.py — or set same paths in UI wizard → local_paths.json)
PDFS_DIR=./data/PDF
JIRA_MD_DIR=./data/MD
TESTCASES_CSV=./data/CSV/testcases_vwo_100.csv
SELENIUM_REPO_DIR=./data/repos/ATB14xSeleniumAdvanceFrameworks
PLAYWRIGHT_REPO_DIR=./data/repos/Advance-Playwright-Framework

# Optional model overrides (defaults: BAAI/bge-m3, BAAI/bge-reranker-v2-m3)
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
